{
  "name": "reasonable-tech",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --prefix frontend run dev -- --host 0.0.0.0 --port 5173",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "start:backend": "npm --prefix backend run start",
    "preview:frontend": "npm --prefix frontend run preview -- --host 0.0.0.0 --port 4173"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
